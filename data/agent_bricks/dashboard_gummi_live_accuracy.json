{
 "datasets": [
  {
   "name": "overall",
   "displayName": "Overall accuracy (out-of-sample)",
   "queryLines": [
    "SELECT grades, gummi_mae_mg_dl, cgm_only_mae_mg_dl, last_value_mae_mg_dl, gummi_beats_cgm_only_pct, gummi_beats_last_value_pct, last_graded_at\n",
    "FROM workspace.gummi_data.stream_gold_accuracy\n",
    "WHERE sample = 'out-of-sample' AND user_id = 'ALL' AND window_type = 'all'"
   ]
  },
  {
   "name": "by_window",
   "displayName": "Error by window type",
   "queryLines": [
    "SELECT window_type, 'Gummi' AS method, 1 AS method_order, gummi_mae_mg_dl AS mae_mg_dl, grades FROM workspace.gummi_data.stream_gold_accuracy WHERE sample = 'out-of-sample' AND user_id = 'ALL'\n",
    "UNION ALL\n",
    "SELECT window_type, 'CGM-only' AS method, 2 AS method_order, cgm_only_mae_mg_dl AS mae_mg_dl, grades FROM workspace.gummi_data.stream_gold_accuracy WHERE sample = 'out-of-sample' AND user_id = 'ALL'\n",
    "UNION ALL\n",
    "SELECT window_type, 'Last value' AS method, 3 AS method_order, last_value_mae_mg_dl AS mae_mg_dl, grades FROM workspace.gummi_data.stream_gold_accuracy WHERE sample = 'out-of-sample' AND user_id = 'ALL'"
   ]
  },
  {
   "name": "by_user",
   "displayName": "Error by participant",
   "queryLines": [
    "SELECT user_id, 'Gummi' AS method, 1 AS method_order, gummi_mae_mg_dl AS mae_mg_dl, grades FROM workspace.gummi_data.stream_gold_accuracy WHERE sample = 'out-of-sample' AND user_id <> 'ALL' AND window_type = 'all'\n",
    "UNION ALL\n",
    "SELECT user_id, 'CGM-only' AS method, 2 AS method_order, cgm_only_mae_mg_dl AS mae_mg_dl, grades FROM workspace.gummi_data.stream_gold_accuracy WHERE sample = 'out-of-sample' AND user_id <> 'ALL' AND window_type = 'all'\n",
    "UNION ALL\n",
    "SELECT user_id, 'Last value' AS method, 3 AS method_order, last_value_mae_mg_dl AS mae_mg_dl, grades FROM workspace.gummi_data.stream_gold_accuracy WHERE sample = 'out-of-sample' AND user_id <> 'ALL' AND window_type = 'all'"
   ]
  },
  {
   "name": "grades_time",
   "displayName": "Grades landing per minute",
   "queryLines": [
    "SELECT date_trunc('MINUTE', ingested_at) AS minute, COUNT(DISTINCT grade_id) AS grades\n",
    "FROM workspace.gummi_data.stream_silver_grades\n",
    "WHERE ingested_at >= current_timestamp() - INTERVAL 6 HOURS\n",
    "GROUP BY 1"
   ]
  },
  {
   "name": "mae_time",
   "displayName": "Error over the replay day",
   "queryLines": [
    "WITH g AS (\n",
    "  SELECT * FROM workspace.gummi_data.stream_silver_grades\n",
    "  WHERE walk_effect_graded\n",
    "  QUALIFY ROW_NUMBER() OVER (PARTITION BY grade_id ORDER BY ingested_at DESC) = 1\n",
    "), b AS (\n",
    "  SELECT window(graded_at, '1 hour').start AS hour, gummi_mae_mg_dl, cgm_only_mae_mg_dl, last_value_mae_mg_dl FROM g\n",
    ")\n",
    "SELECT hour, 'Gummi' AS method, AVG(gummi_mae_mg_dl) AS mae_mg_dl FROM b GROUP BY hour\n",
    "UNION ALL SELECT hour, 'CGM-only', AVG(cgm_only_mae_mg_dl) FROM b GROUP BY hour\n",
    "UNION ALL SELECT hour, 'Last value', AVG(last_value_mae_mg_dl) FROM b GROUP BY hour"
   ]
  },
  {
   "name": "lag_time",
   "displayName": "Pipeline lag and events per minute",
   "queryLines": [
    "SELECT date_trunc('MINUTE', ingested_at) AS minute,\n",
    "       ROUND(AVG(unix_timestamp(ingested_at) - unix_timestamp(landed_at)), 1) AS lag_seconds,\n",
    "       COUNT(*) AS events\n",
    "FROM workspace.gummi_data.stream_bronze_events\n",
    "WHERE ingested_at >= current_timestamp() - INTERVAL 6 HOURS\n",
    "GROUP BY 1"
   ]
  },
  {
   "name": "events_kind",
   "displayName": "Events per minute by kind",
   "queryLines": [
    "SELECT date_trunc('MINUTE', ingested_at) AS minute, kind, COUNT(*) AS events\n",
    "FROM workspace.gummi_data.stream_bronze_events\n",
    "WHERE ingested_at >= current_timestamp() - INTERVAL 6 HOURS\n",
    "GROUP BY 1, 2"
   ]
  },
  {
   "name": "live_now",
   "displayName": "Live now",
   "queryLines": [
    "SELECT\n",
    "  (SELECT ROUND(AVG(unix_timestamp(ingested_at) - unix_timestamp(landed_at)), 1) FROM workspace.gummi_data.stream_bronze_events\n",
    "    WHERE ingested_at >= current_timestamp() - INTERVAL 10 MINUTES) AS lag_seconds_10min,\n",
    "  (SELECT COUNT(*) FROM workspace.gummi_data.stream_bronze_events WHERE ingested_at >= current_timestamp() - INTERVAL 1 MINUTE) AS events_last_minute,\n",
    "  (SELECT COUNT(*) FROM workspace.gummi_data.stream_gold_fleet) AS users_streaming"
   ]
  }
 ],
